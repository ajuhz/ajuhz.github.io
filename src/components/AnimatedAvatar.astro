---
const baseUrl = import.meta.env.BASE_URL;
---

<style>
  @keyframes pulse-glow {
    0%, 100% {
      box-shadow:
        0 0 0 0 rgba(167, 139, 250, 0.7),
        0 0 30px rgba(167, 139, 250, 0.3),
        inset 0 0 30px rgba(167, 139, 250, 0.1);
    }
    50% {
      box-shadow:
        0 0 0 10px rgba(167, 139, 250, 0),
        0 0 40px rgba(167, 139, 250, 0.5),
        inset 0 0 30px rgba(167, 139, 250, 0.2);
    }
  }

  @keyframes float-rotate {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-8px) rotate(1deg);
    }
  }

  @keyframes border-flow {
    0% {
      background-position: 0% 0%;
    }
    100% {
      background-position: 100% 100%;
    }
  }

  @keyframes node-pulse {
    0%, 100% {
      opacity: 0.6;
      r: 4px;
    }
    50% {
      opacity: 1;
      r: 6px;
    }
  }

  .avatar-container {
    position: relative;
    width: 200px;
    height: 200px;
    margin: 0 auto;
  }

  .avatar-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    animation: float-rotate 6s ease-in-out infinite;
  }

  .avatar-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      #a78bfa 0%,
      #c084fc 25%,
      #fbbf24 50%,
      #c084fc 75%,
      #a78bfa 100%
    );
    padding: 3px;
    animation: border-flow 8s linear infinite;
  }

  .avatar-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: #0f172a;
    border: 2px solid #1e293b;
    animation: pulse-glow 3s ease-in-out infinite;
  }

  .avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .avatar-overlay {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(16, 185, 129, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  /* Animated corner elements */
  .corner-accent {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2px solid #fbbf24;
    border-radius: 2px;
    opacity: 0.6;
  }

  .corner-tl {
    top: -8px;
    left: -8px;
    border-right: none;
    border-bottom: none;
  }

  .corner-tr {
    top: -8px;
    right: -8px;
    border-left: none;
    border-bottom: none;
  }

  .corner-bl {
    bottom: -8px;
    left: -8px;
    border-right: none;
    border-top: none;
  }

  .corner-br {
    bottom: -8px;
    right: -8px;
    border-left: none;
    border-top: none;
  }

  /* Decorative nodes */
  .node {
    position: absolute;
    background: #fbbf24;
    border-radius: 50%;
    box-shadow: 0 0 10px rgba(251, 191, 36, 0.6);
  }

  .node-1 {
    width: 8px;
    height: 8px;
    top: 15%;
    right: -15px;
    animation: node-pulse 2s ease-in-out infinite;
  }

  .node-2 {
    width: 6px;
    height: 6px;
    bottom: 20%;
    left: -12px;
    animation: node-pulse 2.5s ease-in-out infinite 0.3s;
  }

  .node-3 {
    width: 5px;
    height: 5px;
    top: 25%;
    left: -10px;
    animation: node-pulse 3s ease-in-out infinite 0.6s;
  }

  /* Hover effect */
  .avatar-container:hover .avatar-inner {
    animation: pulse-glow 1.5s ease-in-out infinite;
  }

  .avatar-container:hover .node-1 {
    animation: node-pulse 1.5s ease-in-out infinite;
  }

  .avatar-container:hover .node-2 {
    animation: node-pulse 1.5s ease-in-out infinite 0.3s;
  }

  .avatar-container:hover .node-3 {
    animation: node-pulse 1.5s ease-in-out infinite 0.6s;
  }
</style>

<div class="avatar-container">
  <div class="avatar-wrapper">
    <!-- Rotating gradient ring -->
    <div class="avatar-ring">
      <div class="avatar-inner">
        <!-- Avatar image -->
        <img
          src={`${baseUrl}/avatar-animated.jpg`}
          alt="Ajay Hazra"
          class="avatar-image"
        />
        <!-- Subtle overlay -->
        <div class="avatar-overlay"></div>
      </div>
    </div>

    <!-- Corner accents -->
    <div class="corner-accent corner-tl"></div>
    <div class="corner-accent corner-tr"></div>
    <div class="corner-accent corner-bl"></div>
    <div class="corner-accent corner-br"></div>

    <!-- Decorative connection nodes -->
    <div class="node node-1"></div>
    <div class="node node-2"></div>
    <div class="node node-3"></div>
  </div>
</div>
