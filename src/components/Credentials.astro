---
---

<section class="section relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute top-10 left-1/4 w-64 h-64 border border-purple-500/20 rounded-full opacity-30 blur-lg"></div>
  <div class="absolute -bottom-10 right-10 w-80 h-80 border-2 border-amber-400/10 rounded-full opacity-20 blur-xl"></div>

  <div class="container-page relative z-10">
    <h2 class="text-4xl sm:text-5xl font-bold mb-4 text-slate-100">
      Certifications & Credentials
    </h2>
    <p class="text-lg text-slate-400 mb-12 max-w-2xl">
      Industry-recognized certifications and badges showcasing expertise in AI, cloud architecture, and enterprise systems.
    </p>

    <div class="flex flex-col md:flex-row items-center justify-between gap-12">
      <!-- Left: Credly Link with Logo -->
      <div class="flex items-center gap-6 p-8 rounded-xl border border-slate-700/50 hover:border-amber-400/50 transition-colors backdrop-blur hover:bg-slate-800/30">
        <a href="https://www.credly.com/users/ajay-hazra.44809fdb/badges/credly" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-6">
          <svg class="w-16 h-16 text-amber-400 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2L15.09 8.26H21.77L17.13 12.31L18.78 18.59L12 14.54L5.22 18.59L6.87 12.31L2.23 8.26H8.91L12 2Z"/>
          </svg>
          <div>
            <h3 class="text-xl font-bold text-slate-100 group-hover:text-amber-400 transition-colors">
              View All Badges
            </h3>
            <p class="text-sm text-slate-400">
              View on Credly →
            </p>
          </div>
        </a>
      </div>

      <!-- Right: Info -->
      <div class="md:flex-1">
        <h3 class="text-xl font-bold text-slate-100 mb-4">
          Industry-Recognized Certifications
        </h3>
        <ul class="space-y-3 text-slate-400">
          <li class="flex items-start">
            <span class="text-amber-400 mr-3">✓</span>
            <span>Verified expertise in AI/ML and cloud architecture</span>
          </li>
          <li class="flex items-start">
            <span class="text-amber-400 mr-3">✓</span>
            <span>Earned industry credentials and achievements</span>
          </li>
          <li class="flex items-start">
            <span class="text-amber-400 mr-3">✓</span>
            <span>Continuous professional development</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
