---
import AnimatedAvatar from './AnimatedAvatar.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<section class="section min-h-screen flex items-center justify-center relative overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0 opacity-50 -z-10" style={`background-image: url('${baseUrl}hero-bg.svg'); background-size: cover; background-position: center;`}></div>

  <div class="container-page relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Animated Avatar -->
      <div class="flex justify-center lg:justify-end order-last lg:order-first">
        <AnimatedAvatar />
      </div>

      <!-- Right: Text -->
      <div class="text-center lg:text-left">
        <h1 class="text-5xl sm:text-6xl font-bold mb-6 text-slate-100 tracking-tight">
          Ajay Hazra
        </h1>
        <p class="text-xl sm:text-2xl text-slate-300 mb-8">
          Senior AI Architect
        </p>
        <p class="text-lg text-slate-400 mb-8 leading-relaxed">
          Designing and building production-grade AI systems. Specializing in GenAI, Agentic AI, RAG pipelines, and enterprise AI platforms for regulated industries.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a href="#projects" class="btn-primary">
            View My Work
          </a>
          <a href="https://github.com/ajuhz" class="inline-block px-6 py-3 border-2 border-amber-400 text-amber-400 font-semibold rounded-lg hover:bg-amber-400 hover:text-slate-950 transition-colors">
            GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
