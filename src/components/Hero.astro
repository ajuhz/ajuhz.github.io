---
import AnimatedAvatar from './AnimatedAvatar.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<section class="section min-h-screen flex items-center justify-center relative overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0 -z-10" style={`background-image: url('${baseUrl}hero-workspace.jpg'); background-size: cover; background-position: center;`}></div>
  <!-- Dark overlay for text readability -->
  <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 to-slate-950/70 -z-10"></div>

  <div class="container-page relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Animated Avatar -->
      <div class="flex justify-center lg:justify-end order-last lg:order-first">
        <AnimatedAvatar />
      </div>

      <!-- Right: Text -->
      <div class="text-center lg:text-left">
        <h1 class="text-5xl sm:text-6xl font-bold mb-6 text-slate-100 tracking-tight">
          Ajay Hazra
        </h1>
        <p class="text-xl sm:text-2xl text-slate-300 mb-8">
          Senior AI Architect
        </p>
        <p class="text-lg text-slate-400 mb-8 leading-relaxed">
          Designing and building production-grade AI systems. Specializing in GenAI, Agentic AI, RAG pipelines, and enterprise AI platforms for regulated industries.
        </p>
        <div class="flex gap-6 justify-center lg:justify-start">
          <a href="#projects" class="group" title="View My Work">
            <svg class="w-8 h-8 text-slate-400 group-hover:text-amber-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </a>
          <a href="https://github.com/ajuhz" target="_blank" rel="noopener noreferrer" class="group" title="GitHub">
            <svg class="w-8 h-8 text-slate-400 group-hover:text-amber-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a href="https://linkedin.com/in/ajayhazra" target="_blank" rel="noopener noreferrer" class="group" title="LinkedIn">
            <svg class="w-8 h-8 text-slate-400 group-hover:text-amber-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
            </svg>
          </a>
          <a href="https://www.credly.com/users/ajay-hazra.44809fdb/badges/credly" target="_blank" rel="noopener noreferrer" class="group" title="Credly">
            <svg class="w-8 h-8 text-slate-400 group-hover:text-amber-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L15.09 8.26H21.77L17.13 12.31L18.78 18.59L12 14.54L5.22 18.59L6.87 12.31L2.23 8.26H8.91L12 2Z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
